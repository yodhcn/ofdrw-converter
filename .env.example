# 本地调试配置示例：复制为 .env 后填入你自己的调试信息即可。
# 插件「不需要发布」，因此这里仅在需要连接 Dify 远程调试时使用。

INSTALL_METHOD=remote
REMOTE_INSTALL_HOST=debug.dify.ai
REMOTE_INSTALL_PORT=5003
REMOTE_INSTALL_KEY=********-****-****-****-************

# 可选：单次转换的超时时间（秒），默认 180
# OFDRW_TIMEOUT=180

# 可选：指定外部 Java 运行时目录；默认优先使用插件自带的 bin/runtime
# OFDRW_JAVA_HOME=C:\Program Files\Java\jdk-21.0.11
